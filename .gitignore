# ==========================================
# Dependencies
# ==========================================
# Blocks massive third-party package directories from bloat
node_modules/
**/node_modules/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
# Never commit your database credentials or API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
config.env

# ==========================================
# Production Builds
# ==========================================
# Build outputs from React or Vite
build/
dist/
out/

# ==========================================
# Debug & Logs
# ==========================================
# System runtime logs and package manager dumps
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# Testing & Coverage
# ==========================================
# Jest or Mocha reports
coverage/
.nyc_output/

# ==========================================
# IDEs and Text Editors
# ==========================================
# Editor-specific configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ==========================================
# Operating System Files
# ==========================================
# System-specific metadata files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
