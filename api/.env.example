NODE_ENV=development
PORT=5000

# MongoDB — local replica set required for transactions
MONGO_URI=mongodb://localhost:27017/slotsync?replicaSet=rs0

# CORS — must match frontend URL
CORS_ORIGIN=http://localhost:5173

# JWT secrets — change these for production
JWT_ACCESS_SECRET=slotsync_dev_access_secret_k7x9m2p4
JWT_REFRESH_SECRET=slotsync_dev_refresh_secret_j5n8q1w6

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
