# ===========================================================
# SlotSync — Environment Variables
# ===========================================================
# Copy this file to .env and fill in the values.
#
# For local development (npm run dev):
#   - Use api/.env with MONGO_URI pointing to local MongoDB
#   - CORS_ORIGIN=http://localhost:5173
#
# For Docker (docker compose up):
#   - Set JWT secrets below (docker-compose reads from here)
#   - MONGO_URI is handled internally by docker-compose
# ===========================================================

# ---------- API ----------
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local dev:  mongodb://localhost:27017/slotsync?replicaSet=rs0
# Docker:     mongodb://mongo:27017/slotsync?replicaSet=rs0  (set in docker-compose)
MONGO_URI=mongodb://localhost:27017/slotsync?replicaSet=rs0

# CORS origin — must match the frontend URL
CORS_ORIGIN=http://localhost:5173

# JWT secrets — CHANGE THESE in production
JWT_ACCESS_SECRET=slotsync_dev_access_secret_k7x9m2p4
JWT_REFRESH_SECRET=slotsync_dev_refresh_secret_j5n8q1w6

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Frontend (Vite) ----------
# VITE_API_URL is baked into the build at build time.
# For local dev, create web/.env with:
#   VITE_API_URL=http://localhost:5000/api
# For Docker, the docker-compose build sets this automatically.
